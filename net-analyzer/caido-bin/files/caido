#!/bin/sh
# Wrapper for Caido desktop (Gentoo): reads extra flags from
# ${XDG_CONFIG_HOME:-~/.config}/caido-flags.conf, '#' = comment.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/caido-flags.conf"
flags=""
if [ -r "$conf" ]; then
	flags=$(sed -e 's/#.*//' "$conf" | tr '\n' ' ')
fi
# shellcheck disable=SC2086
exec /opt/caido/caido --ozone-platform-hint=auto $flags "$@"
