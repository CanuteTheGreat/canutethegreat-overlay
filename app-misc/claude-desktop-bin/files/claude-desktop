#!/bin/sh
# Wrapper for Claude Desktop (Gentoo): reads extra flags from
# ${XDG_CONFIG_HOME:-~/.config}/claude-desktop-flags.conf, one or more per line, '#' = comment.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/claude-desktop-flags.conf"
flags=""
if [ -r "$conf" ]; then
	flags=$(sed -e 's/#.*//' "$conf" | tr '\n' ' ')
fi
# shellcheck disable=SC2086
exec /opt/claude-desktop/claude-desktop --ozone-platform-hint=auto $flags "$@"
